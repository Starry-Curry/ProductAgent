{
  "name": "product-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:life": "node scripts/life-local.mjs dev",
    "start:life": "node scripts/life-local.mjs start",
    "test:life": "node scripts/verify-local.mjs life",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:benchmark": "node --experimental-strip-types scripts/benchmark.ts",
    "dev:local": "node scripts/local-demo.mjs dev",
    "start:local": "node scripts/local-demo.mjs start",
    "test:integration": "node tests/integration.mjs",
    "test:live": "node --experimental-strip-types scripts/live-smoke.ts",
    "test:acceptance": "node scripts/verify-local.mjs",
    "test:live:system": "node scripts/live-system.mjs",
    "export:review": "node scripts/export-review.mjs"
  },
  "dependencies": {
    "@langchain/core": "1.2.18",
    "@langchain/langgraph": "1.5.1",
    "@langchain/langgraph-checkpoint": "1.2.0",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@zxing/browser": "^0.2.1",
    "cheerio": "^1.2.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "yet-another-react-lightbox": "^3.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  },
  "type": "module"
}
