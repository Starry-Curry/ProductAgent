{
  "name": "product-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:benchmark": "node --experimental-strip-types scripts/benchmark.ts",
    "dev:local": "node scripts/local-demo.mjs dev",
    "start:local": "node scripts/local-demo.mjs start",
    "test:integration": "node tests/integration.mjs",
    "test:live": "node --experimental-strip-types scripts/live-smoke.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  },
  "type": "module"
}
