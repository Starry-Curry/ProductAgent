# Local demo works without this file. These settings are only for optional AI.
# Never commit .env.local or put AI_API_KEY in NEXT_PUBLIC_* variables.
PORT=3200

AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=
AI_MODEL=qwen-plus
AI_JSON_MODE=true
AI_ENABLE_THINKING=false

# Two explicit gates must both be true before paid calls are allowed.
AI_ALLOW_PAID_CALLS=false
WUJIAN_ALLOW_PAID_CALLS=false

WUJIAN_ALLOW_SEARCH=false
AI_REQUEST_TIMEOUT_MS=60000

# Experimental answer engines stay off until real task quality gates pass.
WUJIAN_EXPERIMENTAL_FACT_QA=false
WUJIAN_EXPERIMENTAL_KERNEL_V3=false

# Native read-only tool loop; only runs when model configuration and paid gates
# are explicitly enabled. Use legacy to restore the previous default path.
WUJIAN_AGENT_RUNTIME=native

LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
