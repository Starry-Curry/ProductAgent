# Copy to .env locally. Never paste keys into screenshots or commit .env.
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3.6-plus
QWEN_THINKING=true
# Provider transport; app progress remains live through SSE in either mode.
QWEN_STREAM=false
# Optional: set the endpoint supplied by your Bailian account/region.
# DASHSCOPE_BASE_URL=
# Optional separate vision model for original PDF page interpretation.
# Chat photos use the primary multimodal Qwen model above.
QWEN_VISION_MODEL=qwen3-vl-plus
# Semantic retrieval uses the same Bailian account; original facts remain in SQL.
QWEN_EMBEDDING_MODEL=text-embedding-v4
# Optional Intel local semantic retrieval. Download/probe with scripts/local_ai.py.
# WUJIAN_LOCAL_EMBEDDING_DIR=var/models/multilingual-minilm
# WUJIAN_LOCAL_AI_DEVICE=NPU
# WUJIAN_LOCAL_AI_REQUIRED=true
# REA is started lazily only for an explicit connection/exploration request.
WUJIAN_REA_ENABLED=true
# Optional absolute path to rea-agents/scripts/rea.mjs (version 6.8.0).
# WUJIAN_REA_ENTRY=
# Optional JSON array of operator-approved software directories.
# Default: var/device-artifacts. Copy a target package there for exploration.
# WUJIAN_REA_ARTIFACT_ROOTS=["D:/approved-device-software"]
# Local development uses SQLite. PostgreSQL needs a driver and migration verification.
# DATABASE_URL=postgresql+psycopg://user:password@localhost/wujian
WUJIAN_HOST=127.0.0.1
WUJIAN_PORT=8000
WUJIAN_DEMO_MODE=true
# Optional persistent secret; otherwise a local private session key is generated.
# WUJIAN_SESSION_SECRET=
