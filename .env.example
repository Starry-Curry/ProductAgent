# Copy to .env locally. Never paste keys into screenshots or commit .env.
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3.6-plus
QWEN_THINKING=true
# Optional experiment only; leave unset to keep provider default.
# QWEN_THINKING_BUDGET=2048
# Provider transport; app progress remains live through SSE in either mode.
QWEN_STREAM=false
# Optional: set the endpoint supplied by your Bailian account/region.
# DASHSCOPE_BASE_URL=
# Compatibility for the parallel teaching/scene-extraction integration.
# Ordinary PDF pages, chat photos and video frames use the primary model.
QWEN_VISION_MODEL=qwen3-vl-plus
# Optional object-shaped portrait generation, using this same Bailian account.
# Default after real-photo verification; never called by offline tests.
# QWEN_AVATAR_IMAGE_MODEL=qwen-image-2.1-pro
# Semantic retrieval uses the same Bailian account; original facts remain in SQL.
QWEN_EMBEDDING_MODEL=text-embedding-v4
# Optional public-video observations: uv sync --extra video, plus local FFmpeg.
# FFMPEG_BINARY=C:/absolute/path/to/ffmpeg.exe
# Optional bounded MediaCrawler integration; keep upstream in its own environment.
# WUJIAN_MEDIACRAWLER_PYTHON=C:/absolute/path/to/isolated/Scripts/python.exe
# WUJIAN_MEDIACRAWLER_SOURCE=C:/absolute/path/to/MediaCrawler
# Default anonymous provider is yt-dlp. An explicit temporary QR session can
# use MediaCrawler without changing the provider. No account cookies in .env.
# WUJIAN_COMMUNITY_PROVIDER=mediacrawler
# REA is started lazily only for an explicit connection/exploration request.
WUJIAN_REA_ENABLED=true
# Optional absolute path to rea-agents/scripts/rea.mjs (version 6.8.0).
# WUJIAN_REA_ENTRY=
# Optional JSON array of operator-approved software directories.
# Default: var/device-artifacts. Copy a target package there for exploration.
# WUJIAN_REA_ARTIFACT_ROOTS=["D:/approved-device-software"]
# Local development uses SQLite. PostgreSQL needs a driver and migration verification.
# DATABASE_URL=postgresql+psycopg://user:password@localhost/wujian
WUJIAN_HOST=127.0.0.1
WUJIAN_PORT=8000
WUJIAN_DEMO_MODE=true
# On an empty database, load the owner-approved photos and saved demo journeys.
WUJIAN_SHOWCASE=true
# Optional isolated directory for trying the downloadable showcase alongside existing data.
# WUJIAN_DATA_DIR=var-showcase
# Optional persistent secret; otherwise a local private session key is generated.
# WUJIAN_SESSION_SECRET=

# 3D diagram generation only: Bailian Tripo first, local Hunyuan mini on failure.
# Reuses DASHSCOPE_API_KEY and optional DASHSCOPE_WORKSPACE_ID above.
# WUJIAN_3D_HTTP_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# Keep large generation files on the project disk, not the system disk.
# WUJIAN_3D_CACHE_DIR=D:/Project/Tianmao/ProductAgent/var/model-generation
# Existing Hunyuan runtime: repos/Hunyuan3D-2, models/hunyuan-mini, cache/u2net/u2netp.onnx.
# WUJIAN_3D_LOCAL_HOME=D:/Project/Tianmao/ProductAgent/experiments/local_3d
# WUJIAN_3D_LOCAL_PYTHON=D:/Project/Tianmao/ProductAgent/experiments/local_3d/envs/hunyuan3d/python.exe
