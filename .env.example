# Demo roles are enabled explicitly by dev:local / start:local.
AUTH_MODE=
# Alibaba Cloud Model Studio, Beijing. Use a key from the same region.
# https://help.aliyun.com/zh/model-studio/compatibility-of-openai-with-dashscope
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=
AI_MODEL=qwen-plus
# qwen-plus defaults to non-thinking mode and supports JSON Object.
AI_JSON_MODE=true
AI_ENABLE_THINKING=false
# No external LangSmith tracing by default.
LANGSMITH_TRACING=false
# Enable locally only when authorizing user-initiated model requests.
AI_ALLOW_PAID_CALLS=false
# Default is offline. The life launcher requires explicit --cloud for this process.
WUJIAN_ALLOW_PAID_CALLS=false

# Optional vision model; separate per-photo consent and process authorization required.
# AI_VISION_MODEL=qwen-vl-plus

# Optional native Beijing Qwen turbo search; separate opt-in, paid model calls also required.
# Published Beijing search price checked 2026-10-20: RMB 3/1000, plus model tokens.
WUJIAN_ALLOW_SEARCH=false
