            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Id"
        },
        "personal_description": {
          "default": "",
          "title": "Personal Description",
          "type": "string"
        }
      },
