+              );
+              const fact = pack?.claims.find((c) => c.id === id);
+              return pack && fact ? (
+                <p key={id}>
+                  {fact.text}{" "}
+                  <a href={pack.source.url} target="_blank" rel="noreferrer">
+                    {pack.product} · 官方资料 ↗
+                  </a>
+                </p>
+              ) : null;
+            })}
+          </details>
+        </article>
+      ))}
+    </section>
+  );
+}
