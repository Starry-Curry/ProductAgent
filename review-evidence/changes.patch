+    throw new Error("演示身份不允许代理转发");
+  if (r.headers.get("sec-fetch-site") === "cross-site")
+    throw new Error("拒绝跨站请求");
+  const origin = r.headers.get("origin");
+  if (origin && origin !== `${new URL(r.url).protocol}//${rawHost}`)
