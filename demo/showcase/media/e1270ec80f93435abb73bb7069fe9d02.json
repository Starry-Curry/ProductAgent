{"css":"","html":"<div class=\"rhythm-echo\">\n  <header class=\"re-header\">\n    <h2>节奏回声</h2>\n    <p class=\"re-subtitle\">听一小段节奏，跟着敲出来</p>\n  </header>\n\n  <div class=\"re-mute-status\" id=\"re-mute-status\">\n    <span class=\"re-mute-label\">系统静音：</span>\n    <span class=\"re-mute-value\" id=\"re-mute-value\">—</span>\n    <span class=\"re-mute-hint\" id=\"re-mute-hint\"></span>\n  </div>\n\n  <div class=\"re-phase\" id=\"re-phase\">点击播放，听听今天的节奏</div>\n\n  <button class=\"re-play-btn\" id=\"re-play-btn\">▶ 播放节奏</button>\n\n  <button class=\"re-tap-btn\" id=\"re-tap-btn\" style=\"display:none;\">敲！</button>\n\n  <div class=\"re-feedback\" id=\"re-feedback\"></div>\n\n  <button class=\"re-replay-btn\" id=\"re-replay-btn\" style=\"display:none;\">再玩一次</button>\n\n  <div class=\"re-status-bar\" id=\"re-status-bar\">就绪</div>\n</div>","javascript":""}