{"css":"","html":"<div class=\"earbud-console\">\n  <header class=\"console-header\">\n    <h2>FreeBuds 4E</h2>\n    <p class=\"subtitle\">华为耳机 · 简洁操控</p>\n  </header>\n\n  <section class=\"battery-section\">\n    <h3>电量</h3>\n    <div class=\"battery-grid\">\n      <div class=\"battery-card\" id=\"battery-left\">\n        <span class=\"battery-label\">左耳</span>\n        <span class=\"battery-value\" id=\"left-value\">—</span>\n        <span class=\"battery-unit\">%</span>\n        <div class=\"battery-bar\"><div class=\"battery-fill\" id=\"left-fill\"></div></div>\n      </div>\n      <div class=\"battery-card\" id=\"battery-right\">\n        <span class=\"battery-label\">右耳</span>\n        <span class=\"battery-value\" id=\"right-value\">—</span>\n        <span class=\"battery-unit\">%</span>\n        <div class=\"battery-bar\"><div class=\"battery-fill\" id=\"right-fill\"></div></div>\n      </div>\n      <div class=\"battery-card\" id=\"battery-case\">\n        <span class=\"battery-label\">充电盒</span>\n        <span class=\"battery-value\" id=\"case-value\">—</span>\n        <span class=\"battery-unit\">%</span>\n        <div class=\"battery-bar\"><div class=\"battery-fill\" id=\"case-fill\"></div></div>\n      </div>\n    </div>\n    <button class=\"refresh-btn\" id=\"btn-refresh\">刷新电量</button>\n  </section>\n\n  <section class=\"noise-section\">\n    <h3>降噪模式</h3>\n    <div class=\"noise-buttons\" id=\"noise-buttons\">\n      <button class=\"noise-btn\" data-mode=\"off\">关闭降噪</button>\n      <button class=\"noise-btn\" data-mode=\"light\">轻度降噪</button>\n      <button class=\"noise-btn\" data-mode=\"balanced\">均衡降噪</button>\n    </div>\n    <p class=\"current-mode\" id=\"current-mode\">当前：—</p>\n  </section>\n\n  <section class=\"volume-section\">\n    <h3>Windows 输出音量</h3>\n    <div class=\"volume-control\">\n      <input type=\"range\" id=\"volume-slider\" min=\"0\" max=\"100\" value=\"50\" step=\"1\">\n      <span class=\"volume-display\" id=\"volume-display\">—</span>\n    </div>\n    <div class=\"volume-actions\">\n      <button class=\"vol-btn\" id=\"btn-read-volume\">读取音量</button>\n      <button class=\"vol-btn\" id=\"btn-set-volume\">设置音量</button>\n    </div>\n  </section>\n\n  <div class=\"status-bar\" id=\"status-bar\">就绪</div>\n</div>","javascript":""}