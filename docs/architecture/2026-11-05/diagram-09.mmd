flowchart TB
    USER["同一登录身份与同一item_id"] --> SHARE["POST shares / DELETE share：物品拥有者授予或撤回只读"]
    SHARE --> ACCESS["item_grants + accessible_item；公开证据接续"]
    USER --> GIFT["POST gifts：拥有者、好友、选中故事校验"]
    GIFT --> SNAP["gifts.snapshot：物品信息、寄语、分身、故事、公开来源ID"]
    SNAP --> ACCEPT["接收者 POST accept：条件更新owner；清共享"]
    ACCEPT --> PROF["接收者Profile：寄语和选定分身"]
    ACCEPT --> STORY["复制选定经历；保留原作者与origin_id"]
    ACCEPT --> EVID["copy_public_evidence：公开来源与原文摘录"]
    ACCEPT --> RESET["双方上下文失效；停止相应运行状态"]
    USER --> REM["POST reminders / complete：创建者、负责人、物品、时间、完成布尔值"]
    REM --> FAMILY["现有家庭页面：好友、事项、礼物"]
    USER --> AV["Profile.avatar：昵称、性格、颜色"]
    AV --> CHAT["同一主Agent + 获准经历与个人理解"]
    CHAT --> GROW["evolve_avatar：有原话/经历依据的成长文字"]
    GROW -.-> VIS["待补：独立角色资产、表情动作、经历驱动视觉成长"]
    REM -.-> ORG["待补：家庭组织/角色、接手与已读、周期与通知送达"]
    ORG -.-> SENIOR["待补：大字版与语音逐步指导"]
